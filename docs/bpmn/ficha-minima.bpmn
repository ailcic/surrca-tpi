<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_surrca" targetNamespace="https://github.com/ailcic/surrca-tpi">
  <bpmn:collaboration id="Colab">
    <bpmn:participant id="P_mupn" name="MUPN: publicación de la ficha mínima" processRef="Proc_alta"/>
    <bpmn:participant id="P_comunidad" name="Comunidad académica y público"/>
    <bpmn:messageFlow id="M0" name="Ficha visible en el portal" sourceRef="t3" targetRef="P_comunidad"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_alta" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="L_cyt" name="Secretaría de Ciencia y Técnica">
        <bpmn:flowNodeRef>ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_sis" name="SURRCA (sistema)">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ini" name="Proyecto avalado o subsidiado">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Registrar el proyecto">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t2" name="Validar datos mínimos">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g2" name="¿Datos mínimos completos?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t5" name="Completar datos del proyecto">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t3" name="Publicar ficha mínima del proyecto">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t4" name="Vincular con el perfil, si existe">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="fin" name="Ficha mínima visible">
      <bpmn:incoming>F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="ini" targetRef="t1"/>
    <bpmn:sequenceFlow id="F1" sourceRef="t1" targetRef="t2"/>
    <bpmn:sequenceFlow id="F2" sourceRef="t2" targetRef="g2"/>
    <bpmn:sequenceFlow id="F3" name="Sí" sourceRef="g2" targetRef="t3"/>
    <bpmn:sequenceFlow id="F4" name="No" sourceRef="g2" targetRef="t5"/>
    <bpmn:sequenceFlow id="F5" sourceRef="t5" targetRef="t3"/>
    <bpmn:sequenceFlow id="F6" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="F7" sourceRef="t4" targetRef="fin"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag">
    <bpmndi:BPMNPlane id="Plano" bpmnElement="Colab">
      <bpmndi:BPMNShape id="P_mupn_di" bpmnElement="P_mupn" isHorizontal="true">
        <dc:Bounds x="30" y="30" width="830" height="260"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_cyt_di" bpmnElement="L_cyt" isHorizontal="true">
        <dc:Bounds x="60" y="30" width="800" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_sis_di" bpmnElement="L_sis" isHorizontal="true">
        <dc:Bounds x="60" y="160" width="800" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_comunidad_di" bpmnElement="P_comunidad" isHorizontal="true">
        <dc:Bounds x="400" y="330" width="460" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ini_di" bpmnElement="ini">
        <dc:Bounds x="112" y="77" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="85" y="115" width="90" height="28"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1">
        <dc:Bounds x="205" y="50" width="110" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2">
        <dc:Bounds x="205" y="185" width="110" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g2_di" bpmnElement="g2" isMarkerVisible="true">
        <dc:Bounds x="355" y="205" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="335" y="258" width="90" height="42"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t5_di" bpmnElement="t5">
        <dc:Bounds x="325" y="50" width="110" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3">
        <dc:Bounds x="455" y="185" width="110" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_di" bpmnElement="t4">
        <dc:Bounds x="595" y="185" width="110" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin_di" bpmnElement="fin">
        <dc:Bounds x="762" y="212" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="735" y="250" width="90" height="28"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F0_di" bpmnElement="F0">
        <di:waypoint x="148" y="95"/>
        <di:waypoint x="205" y="95"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="260" y="140"/>
        <di:waypoint x="260" y="185"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="315" y="230"/>
        <di:waypoint x="355" y="230"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="405" y="230"/>
        <di:waypoint x="455" y="230"/>
        <bpmndi:BPMNLabel><dc:Bounds x="411" y="212" width="20" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="380" y="205"/>
        <di:waypoint x="380" y="140"/>
        <bpmndi:BPMNLabel><dc:Bounds x="385" y="185" width="20" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="435" y="95"/>
        <di:waypoint x="510" y="95"/>
        <di:waypoint x="510" y="185"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6">
        <di:waypoint x="565" y="230"/>
        <di:waypoint x="595" y="230"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7">
        <di:waypoint x="705" y="230"/>
        <di:waypoint x="762" y="230"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M0_di" bpmnElement="M0">
        <di:waypoint x="510" y="275"/>
        <di:waypoint x="510" y="330"/>
        <bpmndi:BPMNLabel><dc:Bounds x="436" y="293" width="70" height="28"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
