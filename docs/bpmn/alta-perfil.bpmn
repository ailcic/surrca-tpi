    <bpmn:sequenceFlow id="F6" sourceRef="t4" targetRef="t5"/>
    <bpmn:sequenceFlow id="F7" sourceRef="t5" targetRef="g2"/>
    <bpmn:sequenceFlow id="F8" name="Sí" sourceRef="g2" targetRef="t7"/>
    <bpmn:sequenceFlow id="F9" name="No" sourceRef="g2" targetRef="t6"/>
    <bpmn:sequenceFlow id="F10" sourceRef="t6" targetRef="t7"/>
    <bpmn:sequenceFlow id="F11" sourceRef="t7" targetRef="t8"/>
    <bpmn:sequenceFlow id="F12" sourceRef="t8" targetRef="g4"/>
    <bpmn:sequenceFlow id="F13" name="Sí" sourceRef="g4" targetRef="t12"/>
    <bpmn:sequenceFlow id="F14" name="No" sourceRef="g4" targetRef="g3"/>
    <bpmn:sequenceFlow id="F15" sourceRef="t12" targetRef="g3"/>
    <bpmn:sequenceFlow id="F16" name="Sí" sourceRef="g3" targetRef="t10"/>
    <bpmn:sequenceFlow id="F17" name="No" sourceRef="g3" targetRef="t9"/>
    <bpmn:sequenceFlow id="F18" sourceRef="t9" targetRef="fin2"/>
    <bpmn:sequenceFlow id="F19" sourceRef="t10" targetRef="t11"/>
    <bpmn:sequenceFlow id="F20" sourceRef="t11" targetRef="fin3"/>
  </bpmn:process>
